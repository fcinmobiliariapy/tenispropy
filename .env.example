# GEMINI_API_KEY: Required for Gemini AI API calls (banner & trophy generation).
# Server-side only — never prefix with VITE_.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://playpy.vercel.app).
APP_URL="MY_APP_URL"

# Firebase Web Config (optional in AI Studio; recommended via Vercel Env / .env.local)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Cloudinary Free Tier (25 credits/month, $0 CDN image hosting & automatic WebP/AVIF)
# Option A (Client Unsigned): Configure an unsigned upload preset in Cloudinary Settings -> Upload -> Upload presets
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""
VITE_CLOUDINARY_FOLDER="playpy"

# Option B (Server Signed): Use server-side /api/uploads/cloudinary-sign without exposing API secret
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="playpy"

# Cloudflare Images (Direct Creator Upload via /api/uploads/cloudflare-images/direct-upload)
# Create an API Token with "Cloudflare Images: Edit" in Cloudflare Dashboard
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_IMAGES_API_TOKEN=""
CLOUDFLARE_IMAGES_ACCOUNT_HASH=""
CLOUDFLARE_IMAGES_VARIANT_FULL="public"
CLOUDFLARE_IMAGES_VARIANT_THUMB="public"
# Set to "true" only if Flexible Variants are enabled on your Cloudflare Images account
VITE_CLOUDFLARE_IMAGES_FLEXIBLE_VARIANTS="false"

# Optional preferred provider when multiple are configured: "cloudinary" | "cloudflare_images" | "cloudflare_r2"
VITE_MEDIA_PROVIDER=""

# Optional: Cloudflare R2 (10GB free, $0 egress bandwidth) — Server-side only
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

