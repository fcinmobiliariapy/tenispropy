rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Red de seguridad global (denegación por defecto)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitivas reutilizables
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedSuperAdmin() {
      return isVerified() && 'email' in request.auth.token && request.auth.token.email.lower() == 'elpatriota62@gmail.com';
    }

    function hasStaffDoc() {
      return isVerified() && exists(/databases/$(database)/documents/staff_roles/$(request.auth.uid));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff_roles/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isBootstrappedSuperAdmin()
        || (hasStaffDoc() && (!('active' in staffData()) || staffData().active != false) && staffData().role == 'superadmin');
    }

    function isActiveStaff() {
      return isBootstrappedSuperAdmin()
        || (hasStaffDoc()
          && (!('active' in staffData()) || staffData().active != false)
          && staffData().role in ['superadmin', 'organizador', 'operador', 'editor']);
    }

    function hasLegacyRolePerm(permKey) {
      return isActiveStaff() && !('permissions' in staffData()) && (
        (staffData().role == 'organizador' && permKey in ['canCreate', 'canEdit', 'manageTournaments', 'managePlayers', 'manageDraws', 'manageScheduleAndMedia', 'manageScoring', 'manageLandingPage', 'manageParameters'])
        || (staffData().role == 'operador' && permKey in ['canEdit', 'manageScoring'])
        || (staffData().role == 'editor' && permKey in ['canCreate', 'canEdit', 'managePlayers', 'manageScheduleAndMedia', 'manageLandingPage'])
      );
    }

    function hasStaffPerm(permKey) {
      return isSuperAdmin()
        || (isActiveStaff() && ('permissions' in staffData()) && staffData().permissions[permKey] == true)
        || hasLegacyRolePerm(permKey);
    }

    function isUserManager() {
      return isSuperAdmin() || hasStaffPerm('manageUsers');
    }

    function canAccessTournament(tid) {
      return isSuperAdmin()
        || (isActiveStaff()
          && (('allTournaments' in staffData() && staffData().allTournaments == true) || tid in staffData().assignedTournamentIds));
    }

    function isAnyStaff() {
      return isActiveStaff();
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isOptionalStr(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isOptionalDateStr(val) {
      return val == null || val == '' || isValidDateStr(val);
    }

    function isValidTimeStr(val) {
      return val == null || val == '' || (val is string && val.size() == 5 && val.matches('^\\d{2}:\\d{2}$'));
    }

    function isValidList(val, maxLen) {
      return val is list && val.size() <= maxLen;
    }

    function isSafeImageUrl(val, maxLen) {
      return val is string
        && val.size() >= 1
        && val.size() <= maxLen
        && ((val.size() <= 4096
            && (val.lower().matches('^https?://.+$')
              || val.lower().matches('^/?(uploads|assets|src/assets)/.+$')))
          || (val.size() >= 15
            && val.split(',').size() >= 2
            && val.split(',')[0].size() <= 100
            && val.split(',')[0].lower().matches('^data:image/(png|jpeg|jpg|webp|gif|avif|svg\\+xml)(;[a-z0-9=+._-]+)*$')));
    }

    function isOptionalSafeImageUrl(val, maxLen) {
      return val == null || val == '' || isSafeImageUrl(val, maxLen);
    }

    function isNonNegNum(val, maxVal) {
      return val is number && val >= 0 && val <= maxVal;
    }

    function isValidPlayerIdList(arr, maxLen) {
      return isValidList(arr, maxLen)
        && (arr.size() == 0 || isValidId(arr[0]))
        && (arr.size() < 2 || isValidId(arr[1]));
    }

    // 3. Validadores de integridad por entidad
    function isValidItfConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll(['edition', 'setsToWin', 'gamesPerSet', 'tiebreakAt', 'useTiebreak', 'decisivePointNoAd', 'matchTiebreakThirdSet', 'matchTiebreakPoints'])
        && cfg.keys().hasOnly(['edition', 'setsToWin', 'gamesPerSet', 'tiebreakAt', 'useTiebreak', 'decisivePointNoAd', 'matchTiebreakThirdSet', 'matchTiebreakPoints', 'optionalSetScores', 'setTiebreakPoints', 'tiebreakExactTarget', 'directTiebreakMatch'])
        && isNonEmptyStr(cfg.edition, 60)
        && cfg.setsToWin in [1, 2, 3]
        && cfg.gamesPerSet in [4, 6, 8]
        && cfg.tiebreakAt in [3, 6, 7]
        && cfg.useTiebreak is bool
        && cfg.decisivePointNoAd is bool
        && cfg.matchTiebreakThirdSet is bool
        && cfg.matchTiebreakPoints in [7, 10]
        && (!('optionalSetScores' in cfg) || cfg.optionalSetScores is bool)
        && (!('setTiebreakPoints' in cfg) || cfg.setTiebreakPoints in [7, 10])
        && (!('tiebreakExactTarget' in cfg) || cfg.tiebreakExactTarget is bool)
        && (!('directTiebreakMatch' in cfg) || cfg.directTiebreakMatch is bool);
    }

    function isValidDrawConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll(['groupCount', 'qualifiersPerGroup', 'seedingEnabled', 'pointsWin', 'pointsLoss', 'pointsWoWin', 'pointsWoLoss', 'tiebreakers', 'woHandlingNote'])
        && cfg.keys().hasOnly(['groupCount', 'qualifiersPerGroup', 'seedingEnabled', 'pointsWin', 'pointsLoss', 'pointsWoWin', 'pointsWoLoss', 'tiebreakers', 'woHandlingNote'])
        && cfg.groupCount is number && cfg.groupCount >= 1 && cfg.groupCount <= 32
        && cfg.qualifiersPerGroup is number && cfg.qualifiersPerGroup >= 1 && cfg.qualifiersPerGroup <= 16
        && cfg.seedingEnabled is bool
        && isNonNegNum(cfg.pointsWin, 20)
        && isNonNegNum(cfg.pointsLoss, 20)
        && isNonNegNum(cfg.pointsWoWin, 20)
        && isNonNegNum(cfg.pointsWoLoss, 20)
        && isValidList(cfg.tiebreakers, 7) && cfg.tiebreakers.size() >= 1 && cfg.tiebreakers[0] is string
        && isOptionalStr(cfg.woHandlingNote, 400);
    }

    function isValidPlayerStats(stats) {
      return stats is map
        && stats.keys().hasAll(['matchesPlayed', 'wins', 'losses', 'setsWon', 'setsLost', 'gamesWon', 'gamesLost', 'titles', 'currentStreak'])
        && stats.keys().hasOnly(['matchesPlayed', 'wins', 'losses', 'setsWon', 'setsLost', 'gamesWon', 'gamesLost', 'titles', 'currentStreak'])
        && isNonNegNum(stats.matchesPlayed, 10000)
        && isNonNegNum(stats.wins, 10000)
        && isNonNegNum(stats.losses, 10000)
        && isNonNegNum(stats.setsWon, 50000)
        && isNonNegNum(stats.setsLost, 50000)
        && isNonNegNum(stats.gamesWon, 500000)
        && isNonNegNum(stats.gamesLost, 500000)
        && isNonNegNum(stats.titles, 1000)
        && stats.currentStreak is number && stats.currentStreak >= -1000 && stats.currentStreak <= 1000;
    }

    function isValidFifaConfig(cfg) {
      return cfg is map
        && cfg.keys().hasAll([
          'edition', 'halfMinutes', 'allowExtraTime', 'extraTimeHalfMinutes',
          'penaltyShootoutInKnockout', 'maxSubstitutions', 'pointsWin', 'pointsDraw',
          'pointsLoss', 'qualifyingPhaseEnabled', 'qualifyingStageLabel',
          'allowBestThirds', 'yellowCardSuspensionLimit', 'minMatchesForBestGoalkeeper'
        ])
        && cfg.keys().hasOnly([
          'edition', 'halfMinutes', 'allowExtraTime', 'extraTimeHalfMinutes',
          'penaltyShootoutInKnockout', 'maxSubstitutions', 'pointsWin', 'pointsDraw',
          'pointsLoss', 'qualifyingPhaseEnabled', 'qualifyingStageLabel',
          'allowBestThirds', 'yellowCardSuspensionLimit', 'minMatchesForBestGoalkeeper'
        ])
        && isNonEmptyStr(cfg.edition, 60)
        && cfg.halfMinutes is number && cfg.halfMinutes >= 5 && cfg.halfMinutes <= 90
        && cfg.allowExtraTime is bool
        && cfg.extraTimeHalfMinutes is number && cfg.extraTimeHalfMinutes >= 5 && cfg.extraTimeHalfMinutes <= 30
        && cfg.penaltyShootoutInKnockout is bool
        && cfg.maxSubstitutions is number && cfg.maxSubstitutions >= 1 && cfg.maxSubstitutions <= 25
        && isNonNegNum(cfg.pointsWin, 10)
        && isNonNegNum(cfg.pointsDraw, 10)
        && isNonNegNum(cfg.pointsLoss, 10)
        && cfg.qualifyingPhaseEnabled is bool
        && isOptionalStr(cfg.qualifyingStageLabel, 120)
        && cfg.allowBestThirds is bool
        && cfg.yellowCardSuspensionLimit is number && cfg.yellowCardSuspensionLimit >= 1 && cfg.yellowCardSuspensionLimit <= 10
        && cfg.minMatchesForBestGoalkeeper is number && cfg.minMatchesForBestGoalkeeper >= 1 && cfg.minMatchesForBestGoalkeeper <= 50;
    }

    function isValidFootballPlayerStats(st) {
      return st is map
        && st.keys().hasAll(['matchesPlayed', 'minutesPlayed', 'goals', 'penaltyGoals', 'ownGoals', 'assists', 'yellowCards', 'redCards', 'goalsConceded', 'cleanSheets'])
        && st.keys().hasOnly(['matchesPlayed', 'minutesPlayed', 'goals', 'penaltyGoals', 'ownGoals', 'assists', 'yellowCards', 'redCards', 'goalsConceded', 'cleanSheets'])
        && isNonNegNum(st.matchesPlayed, 10000)
        && isNonNegNum(st.minutesPlayed, 500000)
        && isNonNegNum(st.goals, 10000)
        && isNonNegNum(st.penaltyGoals, 10000)
        && isNonNegNum(st.ownGoals, 1000)
        && isNonNegNum(st.assists, 10000)
        && isNonNegNum(st.yellowCards, 5000)
        && isNonNegNum(st.redCards, 1000)
        && isNonNegNum(st.goalsConceded, 10000)
        && isNonNegNum(st.cleanSheets, 10000);
    }

    function isValidFootballScore(fs) {
      return fs == null || (
        fs is map
        && fs.keys().hasAll(['goalsA', 'goalsB', 'decidedBy'])
        && fs.keys().hasOnly(['goalsA', 'goalsB', 'halfTimeA', 'halfTimeB', 'extraTimeA', 'extraTimeB', 'penaltiesA', 'penaltiesB', 'decidedBy'])
        && isNonNegNum(fs.goalsA, 99)
        && isNonNegNum(fs.goalsB, 99)
        && (!('halfTimeA' in fs) || fs.halfTimeA == null || isNonNegNum(fs.halfTimeA, 99))
        && (!('halfTimeB' in fs) || fs.halfTimeB == null || isNonNegNum(fs.halfTimeB, 99))
        && (!('extraTimeA' in fs) || fs.extraTimeA == null || isNonNegNum(fs.extraTimeA, 99))
        && (!('extraTimeB' in fs) || fs.extraTimeB == null || isNonNegNum(fs.extraTimeB, 99))
        && (!('penaltiesA' in fs) || fs.penaltiesA == null || isNonNegNum(fs.penaltiesA, 99))
        && (!('penaltiesB' in fs) || fs.penaltiesB == null || isNonNegNum(fs.penaltiesB, 99))
        && fs.decidedBy in ['regular', 'extra_time', 'penalties', 'wo']
      );
    }

    function isValidFootballSheet(sh) {
      return sh == null || (
        sh is map
        && sh.keys().hasAll(['lineupA', 'lineupB', 'events', 'substitutions'])
        && sh.keys().hasOnly([
          'referee', 'assistantRef1', 'assistantRef2', 'fourthOfficial',
          'attendance', 'notes', 'lineupA', 'lineupB',
          'goalkeeperAId', 'goalkeeperAName', 'goalkeeperBId', 'goalkeeperBName',
          'events', 'substitutions', 'signedByReferee', 'signedAt'
        ])
        && (!('referee' in sh) || isOptionalStr(sh.referee, 120))
        && (!('assistantRef1' in sh) || isOptionalStr(sh.assistantRef1, 120))
        && (!('assistantRef2' in sh) || isOptionalStr(sh.assistantRef2, 120))
        && (!('fourthOfficial' in sh) || isOptionalStr(sh.fourthOfficial, 120))
        && (!('attendance' in sh) || sh.attendance == null || isNonNegNum(sh.attendance, 200000))
        && (!('notes' in sh) || isOptionalStr(sh.notes, 500))
        && isValidList(sh.lineupA, 35)
        && isValidList(sh.lineupB, 35)
        && (!('goalkeeperAId' in sh) || isOptionalStr(sh.goalkeeperAId, 128))
        && (!('goalkeeperAName' in sh) || isOptionalStr(sh.goalkeeperAName, 160))
        && (!('goalkeeperBId' in sh) || isOptionalStr(sh.goalkeeperBId, 128))
        && (!('goalkeeperBName' in sh) || isOptionalStr(sh.goalkeeperBName, 160))
        && isValidList(sh.events, 60)
        && isValidList(sh.substitutions, 25)
        && (!('signedByReferee' in sh) || sh.signedByReferee is bool)
        && (!('signedAt' in sh) || isOptionalStr(sh.signedAt, 40))
      );
    }

    function isValidStaffPermissions(perms) {
      return perms is map
        && perms.keys().hasAll([
          'canCreate', 'canEdit', 'canDelete',
          'manageTournaments', 'managePlayers', 'manageDraws',
          'manageScheduleAndMedia', 'manageScoring', 'manageLandingPage',
          'manageParameters', 'manageUsers'
        ])
        && perms.keys().hasOnly([
          'canCreate', 'canEdit', 'canDelete',
          'manageTournaments', 'managePlayers', 'manageDraws',
          'manageScheduleAndMedia', 'manageScoring', 'manageLandingPage',
          'manageParameters', 'manageUsers'
        ])
        && perms.canCreate is bool
        && perms.canEdit is bool
        && perms.canDelete is bool
        && perms.manageTournaments is bool
        && perms.managePlayers is bool
        && perms.manageDraws is bool
        && perms.manageScheduleAndMedia is bool
        && perms.manageScoring is bool
        && perms.manageLandingPage is bool
        && perms.manageParameters is bool
        && perms.manageUsers is bool;
    }

    function isValidStaffRole(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'assignedTournamentIds', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'assignedTournamentIds', 'allTournaments', 'active', 'permissions', 'inviteId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid) && data.uid == uid
        && isNonEmptyStr(data.email, 160)
        && isNonEmptyStr(data.displayName, 120)
        && data.role in ['superadmin', 'organizador', 'operador', 'editor']
        && isValidList(data.assignedTournamentIds, 50)
        && (data.assignedTournamentIds.size() == 0 || data.assignedTournamentIds[0] is string)
        && (!('allTournaments' in data) || data.allTournaments is bool)
        && (!('active' in data) || data.active is bool)
        && (!('permissions' in data) || isValidStaffPermissions(data.permissions))
        && (!('inviteId' in data) || isOptionalStr(data.inviteId, 160))
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidStaffInvite(data, inviteId) {
      return data.keys().hasAll(['id', 'email', 'emailLower', 'displayName', 'role', 'permissions', 'assignedTournamentIds', 'allTournaments', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'emailLower', 'displayName', 'role', 'permissions', 'assignedTournamentIds', 'allTournaments', 'active', 'claimedUid', 'createdByEmail', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == inviteId
        && isNonEmptyStr(data.email, 160)
        && isNonEmptyStr(data.emailLower, 160)
        && isNonEmptyStr(data.displayName, 120)
        && data.role in ['superadmin', 'organizador', 'operador', 'editor']
        && isValidStaffPermissions(data.permissions)
        && isValidList(data.assignedTournamentIds, 50)
        && (data.assignedTournamentIds.size() == 0 || data.assignedTournamentIds[0] is string)
        && data.allTournaments is bool
        && data.active is bool
        && (!('claimedUid' in data) || isOptionalStr(data.claimedUid, 128))
        && (!('createdByEmail' in data) || isOptionalStr(data.createdByEmail, 160))
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidTournament(data, tournamentId) {
      return data.keys().hasAll(['id', 'name', 'organizerName', 'organizerUid', 'venue', 'city', 'timezone', 'courts', 'startDate', 'endDate', 'regStartDate', 'regEndDate', 'minRestMinutes', 'itfEdition', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'sport', 'name', 'organizerName', 'organizerUid', 'venue', 'city', 'timezone', 'courts', 'startDate', 'endDate', 'regStartDate', 'regEndDate', 'minRestMinutes', 'itfEdition', 'status', 'coverImageUrl', 'isDemo', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == tournamentId
        && (!('sport' in data) || data.sport in ['tennis', 'football'])
        && isNonEmptyStr(data.name, 140)
        && isNonEmptyStr(data.organizerName, 120)
        && isNonEmptyStr(data.organizerUid, 128)
        && isNonEmptyStr(data.venue, 140)
        && isNonEmptyStr(data.city, 80)
        && isNonEmptyStr(data.timezone, 64)
        && isValidList(data.courts, 30)
        && data.courts.size() >= 1
        && data.courts[0] is map
        && data.courts[0].keys().hasAll(['id', 'name', 'surface', 'lights'])
        && data.courts[0].keys().hasOnly(['id', 'name', 'surface', 'lights'])
        && isValidDateStr(data.startDate)
        && isValidDateStr(data.endDate)
        && isValidDateStr(data.regStartDate)
        && isValidDateStr(data.regEndDate)
        && data.minRestMinutes is number && data.minRestMinutes >= 0 && data.minRestMinutes <= 10080
        && isNonEmptyStr(data.itfEdition, 60)
        && data.status in ['borrador', 'inscripciones', 'en_curso', 'finalizado']
        && (!('coverImageUrl' in data) || isOptionalSafeImageUrl(data.coverImageUrl, 300000))
        && (!('isDemo' in data) || data.isDemo is bool)
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidDivision(data, divisionId) {
      return data.keys().hasAll(['id', 'tournamentId', 'name', 'category', 'modality', 'gender', 'format', 'allowMultiDivision', 'maxEntries', 'itfConfig', 'drawConfig', 'drawStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'sport', 'footballFormat', 'fifaConfig', 'name', 'category', 'modality', 'gender', 'format', 'allowMultiDivision', 'maxEntries', 'itfConfig', 'drawConfig', 'drawStatus', 'hasThirdPlaceMatch', 'championEntryId', 'championName', 'runnerUpName', 'thirdPlaceEntryId', 'thirdPlaceName', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == divisionId
        && isValidId(data.tournamentId)
        && (!('sport' in data) || data.sport in ['tennis', 'football'])
        && (!('footballFormat' in data) || data.footballFormat in ['futbol_11', 'futbol_7', 'futbol_5_futsal'])
        && (!('fifaConfig' in data) || isValidFifaConfig(data.fifaConfig))
        && isNonEmptyStr(data.name, 120)
        && isNonEmptyStr(data.category, 40)
        && data.modality in ['Singles', 'Dobles', 'Equipo']
        && data.gender in ['Femenino', 'Masculino', 'Mixto']
        && data.format in ['todos_contra_todos', 'grupos_y_final', 'eliminacion_directa', 'grupos_clasificatoria_final']
        && data.allowMultiDivision is bool
        && data.maxEntries is number && data.maxEntries >= 2 && data.maxEntries <= 256
        && isValidItfConfig(data.itfConfig)
        && isValidDrawConfig(data.drawConfig)
        && data.drawStatus in ['sin_sorteo', 'borrador', 'publicado']
        && (!('hasThirdPlaceMatch' in data) || data.hasThirdPlaceMatch is bool)
        && (!('championEntryId' in data) || isOptionalStr(data.championEntryId, 128))
        && (!('championName' in data) || isOptionalStr(data.championName, 160))
        && (!('runnerUpName' in data) || isOptionalStr(data.runnerUpName, 160))
        && (!('thirdPlaceEntryId' in data) || isOptionalStr(data.thirdPlaceEntryId, 128))
        && (!('thirdPlaceName' in data) || isOptionalStr(data.thirdPlaceName, 160))
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidPlayerPublic(data, playerId) {
      return data.keys().hasAll(['id', 'tournamentId', 'firstName', 'lastName', 'fullName', 'club', 'habitualCategory', 'gender', 'dominantHand', 'backhand', 'stats', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'sport', 'teamId', 'jerseyNumber', 'position', 'preferredFoot', 'footballStats', 'firstName', 'lastName', 'fullName', 'club', 'habitualCategory', 'gender', 'dominantHand', 'backhand', 'bio', 'photoUrl', 'stats', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == playerId
        && isValidId(data.tournamentId)
        && (!('sport' in data) || data.sport in ['tennis', 'football'])
        && (!('teamId' in data) || isOptionalStr(data.teamId, 128))
        && (!('jerseyNumber' in data) || data.jerseyNumber == null || (data.jerseyNumber is number && data.jerseyNumber >= 0 && data.jerseyNumber <= 99))
        && (!('position' in data) || data.position == null || data.position in ['Arquero', 'Defensor', 'Mediocampista', 'Delantero'])
        && (!('preferredFoot' in data) || data.preferredFoot == null || data.preferredFoot in ['Derecho', 'Zurdo', 'Ambidiestro'])
        && (!('footballStats' in data) || data.footballStats == null || isValidFootballPlayerStats(data.footballStats))
        && isNonEmptyStr(data.firstName, 80)
        && isNonEmptyStr(data.lastName, 80)
        && isNonEmptyStr(data.fullName, 160)
        && isNonEmptyStr(data.club, 100)
        && isNonEmptyStr(data.habitualCategory, 40)
        && data.gender in ['Femenino', 'Masculino', 'Mixto']
        && data.dominantHand in ['Diestro', 'Zurdo']
        && data.backhand in ['Una mano', 'Dos manos']
        && (!('bio' in data) || isOptionalStr(data.bio, 400))
        && (!('photoUrl' in data) || isOptionalSafeImageUrl(data.photoUrl, 2000))
        && isValidPlayerStats(data.stats)
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidPlayerPrivate(data, playerId) {
      return data.keys().hasAll(['id', 'playerId', 'tournamentId', 'documentNumber', 'birthDate', 'phone', 'email', 'updatedAt'])
        && data.keys().hasOnly(['id', 'playerId', 'tournamentId', 'documentNumber', 'birthDate', 'phone', 'email', 'updatedAt'])
        && isValidId(data.id) && data.id == playerId
        && isValidId(data.playerId) && data.playerId == playerId
        && isValidId(data.tournamentId)
        && isOptionalStr(data.documentNumber, 40)
        && isOptionalStr(data.birthDate, 20)
        && isOptionalStr(data.phone, 40)
        && isOptionalStr(data.email, 160)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidRegistration(data, registrationId) {
      return data.keys().hasAll(['id', 'tournamentId', 'divisionId', 'modality', 'playerIds', 'displayName', 'status', 'registeredAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'divisionId', 'modality', 'playerIds', 'displayName', 'teamShortName', 'coachName', 'teamBadgeUrl', 'primaryColor', 'club', 'seed', 'status', 'groupId', 'registeredAt', 'updatedAt'])
        && isValidId(data.id) && data.id == registrationId
        && isValidId(data.tournamentId)
        && isValidId(data.divisionId)
        && data.modality in ['Singles', 'Dobles', 'Equipo']
        && isValidList(data.playerIds, 35)
        && ((data.modality == 'Singles' && data.playerIds.size() == 1 && isValidId(data.playerIds[0]))
            || (data.modality == 'Dobles' && data.playerIds.size() == 2 && isValidId(data.playerIds[0]) && isValidId(data.playerIds[1]))
            || (data.modality == 'Equipo' && (data.playerIds.size() == 0 || isValidId(data.playerIds[0]))))
        && isNonEmptyStr(data.displayName, 180)
        && (!('teamShortName' in data) || isOptionalStr(data.teamShortName, 16))
        && (!('coachName' in data) || isOptionalStr(data.coachName, 120))
        && (!('teamBadgeUrl' in data) || isOptionalSafeImageUrl(data.teamBadgeUrl, 300000))
        && (!('primaryColor' in data) || isOptionalStr(data.primaryColor, 24))
        && (!('club' in data) || isOptionalStr(data.club, 120))
        && (!('seed' in data) || data.seed == null || (data.seed is number && data.seed >= 1 && data.seed <= 64))
        && data.status in ['pendiente', 'confirmada', 'en_lista_de_espera', 'retirada']
        && (!('groupId' in data) || isOptionalStr(data.groupId, 128))
        && isNonEmptyStr(data.registeredAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidGroup(data, groupId) {
      return data.keys().hasAll(['id', 'tournamentId', 'divisionId', 'name', 'entryIds', 'standings', 'published', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'divisionId', 'name', 'entryIds', 'standings', 'published', 'updatedAt'])
        && isValidId(data.id) && data.id == groupId
        && isValidId(data.tournamentId)
        && isValidId(data.divisionId)
        && isNonEmptyStr(data.name, 60)
        && isValidList(data.entryIds, 32) && (data.entryIds.size() == 0 || data.entryIds[0] is string)
        && isValidList(data.standings, 32) && (data.standings.size() == 0 || data.standings[0] is map)
        && data.published is bool
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidMatchday(data, matchdayId) {
      return data.keys().hasAll(['id', 'tournamentId', 'divisionId', 'name', 'order', 'galleryPublished', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'divisionId', 'name', 'date', 'order', 'description', 'galleryPublished', 'coverPhotoId', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == matchdayId
        && isValidId(data.tournamentId)
        && isValidId(data.divisionId)
        && isNonEmptyStr(data.name, 120)
        && (!('date' in data) || isOptionalDateStr(data.date))
        && data.order is number && data.order >= 1 && data.order <= 100
        && (!('description' in data) || isOptionalStr(data.description, 300))
        && data.galleryPublished is bool
        && (!('coverPhotoId' in data) || isOptionalStr(data.coverPhotoId, 128))
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidMatch(data, matchId) {
      return data.keys().hasAll(['id', 'tournamentId', 'divisionId', 'phase', 'roundName', 'roundOrder', 'entryAName', 'entryBName', 'playerIdsA', 'playerIdsB', 'isBye', 'status', 'sets', 'correctionHistory', 'rescheduleHistory', 'published', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'divisionId', 'matchdayId', 'phase', 'roundName', 'roundOrder', 'bracketPosition', 'nextMatchId', 'nextMatchSlot', 'isThirdPlace', 'groupId', 'entryAId', 'entryAName', 'playerIdsA', 'entryBId', 'entryBName', 'playerIdsB', 'isBye', 'scheduledDate', 'scheduledTime', 'courtId', 'courtName', 'status', 'sets', 'footballScore', 'footballSheet', 'winnerEntryId', 'winnerName', 'outcomeNote', 'correctionHistory', 'rescheduleHistory', 'published', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == matchId
        && isValidId(data.tournamentId)
        && isValidId(data.divisionId)
        && (!('matchdayId' in data) || isOptionalStr(data.matchdayId, 128))
        && data.phase in ['grupos', 'clasificatoria', 'eliminacion']
        && isNonEmptyStr(data.roundName, 140)
        && data.roundOrder is number && data.roundOrder >= 1 && data.roundOrder <= 50
        && (!('bracketPosition' in data) || data.bracketPosition == null || (data.bracketPosition is number && data.bracketPosition >= 1 && data.bracketPosition <= 256))
        && (!('nextMatchId' in data) || isOptionalStr(data.nextMatchId, 128))
        && (!('nextMatchSlot' in data) || data.nextMatchSlot == null || data.nextMatchSlot in ['A', 'B'])
        && (!('isThirdPlace' in data) || data.isThirdPlace is bool)
        && (!('groupId' in data) || isOptionalStr(data.groupId, 128))
        && (!('entryAId' in data) || isOptionalStr(data.entryAId, 128))
        && isNonEmptyStr(data.entryAName, 180)
        && isValidPlayerIdList(data.playerIdsA, 35)
        && (!('entryBId' in data) || isOptionalStr(data.entryBId, 128))
        && isNonEmptyStr(data.entryBName, 180)
        && isValidPlayerIdList(data.playerIdsB, 35)
        && data.isBye is bool
        && (!('scheduledDate' in data) || data.scheduledDate == null || data.scheduledDate == '' || isValidDateStr(data.scheduledDate))
        && (!('scheduledTime' in data) || isValidTimeStr(data.scheduledTime))
        && (!('courtId' in data) || isOptionalStr(data.courtId, 80))
        && (!('courtName' in data) || isOptionalStr(data.courtName, 80))
        && data.status in ['programado', 'en_curso', 'finalizado', 'wo', 'retiro', 'descalificado', 'reprogramado']
        && isValidList(data.sets, 5) && (data.sets.size() == 0 || data.sets[0] is map)
        && (!('footballScore' in data) || isValidFootballScore(data.footballScore))
        && (!('footballSheet' in data) || isValidFootballSheet(data.footballSheet))
        && (!('winnerEntryId' in data) || isOptionalStr(data.winnerEntryId, 128))
        && (!('winnerName' in data) || isOptionalStr(data.winnerName, 180))
        && (!('outcomeNote' in data) || isOptionalStr(data.outcomeNote, 240))
        && isValidList(data.correctionHistory, 30) && (data.correctionHistory.size() == 0 || data.correctionHistory[0] is map)
        && isValidList(data.rescheduleHistory, 30) && (data.rescheduleHistory.size() == 0 || data.rescheduleHistory[0] is map)
        && data.published is bool
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidPhoto(data, photoId) {
      return data.keys().hasAll(['id', 'tournamentId', 'divisionId', 'matchdayId', 'thumbUrl', 'fullUrl', 'order', 'isCover', 'published', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'divisionId', 'matchdayId', 'matchId', 'thumbUrl', 'fullUrl', 'caption', 'order', 'isCover', 'published', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == photoId
        && isValidId(data.tournamentId)
        && isValidId(data.divisionId)
        && isValidId(data.matchdayId)
        && (!('matchId' in data) || isOptionalStr(data.matchId, 128))
        && isSafeImageUrl(data.thumbUrl, 2000)
        && isSafeImageUrl(data.fullUrl, 2000)
        && (!('caption' in data) || isOptionalStr(data.caption, 240))
        && data.order is number && data.order >= 0 && data.order <= 500
        && data.isCover is bool
        && data.published is bool
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll(['id', 'tournamentId', 'title', 'body', 'targetPlayerIds', 'createdAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'divisionId', 'matchId', 'title', 'body', 'targetPlayerIds', 'createdAt'])
        && isValidId(data.id) && data.id == notificationId
        && isValidId(data.tournamentId)
        && (!('divisionId' in data) || isOptionalStr(data.divisionId, 128))
        && (!('matchId' in data) || isOptionalStr(data.matchId, 128))
        && isNonEmptyStr(data.title, 120)
        && isNonEmptyStr(data.body, 500)
        && isValidList(data.targetPlayerIds, 512) && (data.targetPlayerIds.size() == 0 || data.targetPlayerIds[0] is string)
        && isNonEmptyStr(data.createdAt, 40);
    }

    function isValidTournamentAd(data, adId) {
      return data.keys().hasAll(['id', 'tournamentId', 'sponsorName', 'title', 'imageUrl', 'placement', 'order', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'sponsorName', 'title', 'subtitle', 'imageUrl', 'horizontalImageUrl', 'verticalImageUrl', 'aiPrompt', 'targetUrl', 'placement', 'order', 'active', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == adId
        && isValidId(data.tournamentId)
        && isNonEmptyStr(data.sponsorName, 120)
        && isNonEmptyStr(data.title, 120)
        && (!('subtitle' in data) || isOptionalStr(data.subtitle, 240))
        && isSafeImageUrl(data.imageUrl, 300000)
        && (!('horizontalImageUrl' in data) || isOptionalSafeImageUrl(data.horizontalImageUrl, 300000))
        && (!('verticalImageUrl' in data) || isOptionalSafeImageUrl(data.verticalImageUrl, 300000))
        && (!('aiPrompt' in data) || isOptionalStr(data.aiPrompt, 500))
        && (!('targetUrl' in data) || isOptionalStr(data.targetUrl, 2000))
        && data.placement in ['banner_principal', 'lateral', 'pie']
        && data.order is number && data.order >= 0 && data.order <= 500
        && data.active is bool
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidTournamentTrophy(data, trophyId) {
      return data.keys().hasAll(['id', 'tournamentId', 'divisionId', 'divisionName', 'category', 'place', 'title', 'cupStyle', 'finish', 'engravingText', 'imageUrl', 'active', 'order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'tournamentId', 'divisionId', 'divisionName', 'category', 'place', 'title', 'recipientName', 'cupStyle', 'finish', 'engravingText', 'customPrompt', 'aiMotifNote', 'imageUrl', 'active', 'order', 'createdAt', 'updatedAt'])
        && isValidId(data.id) && data.id == trophyId
        && isValidId(data.tournamentId)
        && isValidId(data.divisionId)
        && isNonEmptyStr(data.divisionName, 140)
        && isNonEmptyStr(data.category, 50)
        && data.place in ['campeon', 'vicecampeon', 'tercer_puesto', 'especial']
        && isNonEmptyStr(data.title, 140)
        && (!('recipientName' in data) || isOptionalStr(data.recipientName, 180))
        && data.cupStyle in ['classic_chalice', 'modern_crystal', 'laurel_shield', 'tennis_crown']
        && data.finish in ['gold', 'silver', 'bronze', 'playpy_crystal']
        && isNonEmptyStr(data.engravingText, 200)
        && (!('customPrompt' in data) || isOptionalStr(data.customPrompt, 500))
        && (!('aiMotifNote' in data) || isOptionalStr(data.aiMotifNote, 300))
        && isSafeImageUrl(data.imageUrl, 300000)
        && data.active is bool
        && data.order is number && data.order >= 0 && data.order <= 500
        && isNonEmptyStr(data.createdAt, 40)
        && isNonEmptyStr(data.updatedAt, 40);
    }

    function isValidSiteLandingConfig(data, settingId) {
      return data.keys().hasAll(['id', 'logoUrl', 'platformBadge', 'brandFirst', 'heroTitle', 'primaryCtaLabel', 'bannerEnabled', 'defaultTournamentCoverUrl', 'useAutoMetrics', 'pillars', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'logoUrl', 'platformBadge', 'brandFirst', 'brandSecond', 'brandSubtitle',
          'heroTitle', 'heroDescription', 'heroBackgroundImageUrl', 'primaryCtaLabel', 'secondaryCtaLabel', 'showItfButton',
          'bannerEnabled', 'bannerKicker', 'bannerTitle', 'bannerDescription', 'bannerImageHorizontalUrl', 'bannerImageVerticalUrl',
          'bannerBadgeUrl', 'bannerCtaLabel', 'bannerCtaUrl', 'bannerShowSpotlightAd', 'bannerFooterLeft', 'bannerFooterRight',
          'defaultTournamentCoverUrl', 'useAutoMetrics',
          'stat1Label', 'stat1CustomValue', 'stat2Label', 'stat2CustomValue', 'stat3Label', 'stat3CustomValue', 'stat4Label', 'stat4CustomValue',
          'pillars', 'selectorKicker', 'selectorTitle', 'selectorSubtitle', 'footerTagline', 'footerRightText', 'updatedAt', 'updatedBy'
        ])
        && isValidId(data.id) && data.id == settingId
        && isSafeImageUrl(data.logoUrl, 300000)
        && isNonEmptyStr(data.platformBadge, 80)
        && isNonEmptyStr(data.brandFirst, 40)
        && (!('brandSecond' in data) || isOptionalStr(data.brandSecond, 40))
        && (!('brandSubtitle' in data) || isOptionalStr(data.brandSubtitle, 120))
        && isNonEmptyStr(data.heroTitle, 160)
        && (!('heroDescription' in data) || isOptionalStr(data.heroDescription, 500))
        && (!('heroBackgroundImageUrl' in data) || isOptionalSafeImageUrl(data.heroBackgroundImageUrl, 300000))
        && isNonEmptyStr(data.primaryCtaLabel, 60)
        && (!('secondaryCtaLabel' in data) || isOptionalStr(data.secondaryCtaLabel, 60))
        && (!('showItfButton' in data) || data.showItfButton is bool)
        && data.bannerEnabled is bool
        && (!('bannerKicker' in data) || isOptionalStr(data.bannerKicker, 120))
        && (!('bannerTitle' in data) || isOptionalStr(data.bannerTitle, 180))
        && (!('bannerDescription' in data) || isOptionalStr(data.bannerDescription, 500))
        && (!('bannerImageHorizontalUrl' in data) || isOptionalSafeImageUrl(data.bannerImageHorizontalUrl, 300000))
        && (!('bannerImageVerticalUrl' in data) || isOptionalSafeImageUrl(data.bannerImageVerticalUrl, 300000))
        && (!('bannerBadgeUrl' in data) || isOptionalSafeImageUrl(data.bannerBadgeUrl, 300000))
        && (!('bannerCtaLabel' in data) || isOptionalStr(data.bannerCtaLabel, 60))
        && (!('bannerCtaUrl' in data) || isOptionalStr(data.bannerCtaUrl, 2000))
        && (!('bannerShowSpotlightAd' in data) || data.bannerShowSpotlightAd is bool)
        && (!('bannerFooterLeft' in data) || isOptionalStr(data.bannerFooterLeft, 140))
        && (!('bannerFooterRight' in data) || isOptionalStr(data.bannerFooterRight, 80))
        && isSafeImageUrl(data.defaultTournamentCoverUrl, 300000)
        && data.useAutoMetrics is bool
        && (!('stat1Label' in data) || isOptionalStr(data.stat1Label, 80))
        && (!('stat1CustomValue' in data) || isOptionalStr(data.stat1CustomValue, 40))
        && (!('stat2Label' in data) || isOptionalStr(data.stat2Label, 80))
        && (!('stat2CustomValue' in data) || isOptionalStr(data.stat2CustomValue, 40))
        && (!('stat3Label' in data) || isOptionalStr(data.stat3Label, 80))
        && (!('stat3CustomValue' in data) || isOptionalStr(data.stat3CustomValue, 40))
        && (!('stat4Label' in data) || isOptionalStr(data.stat4Label, 80))
        && (!('stat4CustomValue' in data) || isOptionalStr(data.stat4CustomValue, 40))
        && isValidList(data.pillars, 6)
        && (data.pillars.size() == 0 || (
          data.pillars[0] is map
          && data.pillars[0].keys().hasAll(['title', 'description', 'icon'])
          && data.pillars[0].keys().hasOnly(['title', 'description', 'icon'])
          && isNonEmptyStr(data.pillars[0].title, 100)
          && isOptionalStr(data.pillars[0].description, 280)
          && data.pillars[0].icon in ['award', 'calendar', 'sparkles', 'trophy', 'users', 'shield']
        ))
        && (!('selectorKicker' in data) || isOptionalStr(data.selectorKicker, 100))
        && (!('selectorTitle' in data) || isOptionalStr(data.selectorTitle, 160))
        && (!('selectorSubtitle' in data) || isOptionalStr(data.selectorSubtitle, 300))
        && (!('footerTagline' in data) || isOptionalStr(data.footerTagline, 140))
        && (!('footerRightText' in data) || isOptionalStr(data.footerRightText, 140))
        && isNonEmptyStr(data.updatedAt, 40)
        && (!('updatedBy' in data) || isOptionalStr(data.updatedBy, 160));
    }

    // 4. Reglas por colección
    match /test/connection {
      allow get: if true;
    }

    match /staff_roles/{uid} {
      allow get: if isValidId(uid) && ((isSignedIn() && request.auth.uid == uid) || isUserManager());
      allow list: if isBootstrappedSuperAdmin() || isUserManager();
      allow create: if isValidId(uid) && isValidStaffRole(incoming(), uid) && (
        (isUserManager() && hasStaffPerm('canCreate'))
        || (isVerified()
          && request.auth.uid == uid
          && 'email' in request.auth.token
          && 'inviteId' in incoming()
          && incoming().inviteId is string
          && isValidId(incoming().inviteId)
          && exists(/databases/$(database)/documents/staff_invites/$(incoming().inviteId))
          && get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data.emailLower == request.auth.token.email.lower()
          && get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data.active == true
          && (!('claimedUid' in get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data)
            || get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data.claimedUid == null)
          && incoming().role == get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data.role
          && ('permissions' in incoming())
          && incoming().permissions == get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data.permissions
          && incoming().assignedTournamentIds == get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data.assignedTournamentIds
          && ('allTournaments' in incoming())
          && incoming().allTournaments == get(/databases/$(database)/documents/staff_invites/$(incoming().inviteId)).data.allTournaments
          && ('active' in incoming())
          && incoming().active == true)
      );
      allow update: if isValidId(uid) && isValidStaffRole(incoming(), uid)
        && isUserManager() && hasStaffPerm('canEdit')
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && existing().email.lower() != 'elpatriota62@gmail.com';
      allow delete: if isValidId(uid) && isUserManager() && hasStaffPerm('canDelete')
        && request.auth.uid != uid
        && existing().email.lower() != 'elpatriota62@gmail.com';
    }

    match /staff_invites/{inviteId} {
      allow get: if isValidId(inviteId) && (
        isUserManager()
        || (isVerified() && 'email' in request.auth.token && existing().emailLower == request.auth.token.email.lower())
      );
      allow list: if isBootstrappedSuperAdmin() || isUserManager();
      allow create: if isValidId(inviteId) && isValidStaffInvite(incoming(), inviteId)
        && isUserManager() && hasStaffPerm('canCreate');
      allow update: if isValidId(inviteId) && isValidStaffInvite(incoming(), inviteId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && ((isUserManager() && hasStaffPerm('canEdit'))
          || (isVerified()
            && 'email' in request.auth.token
            && existing().emailLower == request.auth.token.email.lower()
            && existing().active == true
            && (!('claimedUid' in existing()) || existing().claimedUid == null)
            && ('claimedUid' in incoming())
            && incoming().claimedUid == request.auth.uid
            && incoming().emailLower == existing().emailLower
            && incoming().role == existing().role
            && incoming().permissions == existing().permissions
            && incoming().assignedTournamentIds == existing().assignedTournamentIds
            && incoming().allTournaments == existing().allTournaments
            && incoming().active == existing().active));
      allow delete: if isValidId(inviteId) && isUserManager() && hasStaffPerm('canDelete');
    }

    match /tournaments/{tournamentId} {
      allow get: if isValidId(tournamentId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(tournamentId) && isValidTournament(incoming(), tournamentId)
        && hasStaffPerm('manageTournaments') && hasStaffPerm('canCreate');
      allow update: if isValidId(tournamentId) && isValidTournament(incoming(), tournamentId)
        && hasStaffPerm('manageTournaments') && hasStaffPerm('canEdit')
        && canAccessTournament(tournamentId)
        && incoming().id == existing().id
        && (isSuperAdmin() || incoming().organizerUid == existing().organizerUid)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(tournamentId)
        && (isSuperAdmin() || (hasStaffPerm('manageTournaments') && hasStaffPerm('canDelete')))
        && canAccessTournament(tournamentId);
    }

    match /divisions/{divisionId} {
      allow get: if isValidId(divisionId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(divisionId) && isValidDivision(incoming(), divisionId)
        && (hasStaffPerm('manageTournaments') || hasStaffPerm('manageDraws'))
        && hasStaffPerm('canCreate')
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/tournaments/$(incoming().tournamentId));
      allow update: if isValidId(divisionId) && isValidDivision(incoming(), divisionId)
        && (hasStaffPerm('manageTournaments') || hasStaffPerm('manageDraws') || hasStaffPerm('manageScoring') || hasStaffPerm('manageParameters'))
        && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(divisionId)
        && (isSuperAdmin() || (hasStaffPerm('manageTournaments') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /players_public/{playerId} {
      allow get: if isValidId(playerId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(playerId) && isValidPlayerPublic(incoming(), playerId)
        && (hasStaffPerm('managePlayers') || hasStaffPerm('manageTournaments'))
        && hasStaffPerm('canCreate')
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/tournaments/$(incoming().tournamentId));
      allow update: if isValidId(playerId) && isValidPlayerPublic(incoming(), playerId)
        && (hasStaffPerm('managePlayers') || hasStaffPerm('manageScoring') || hasStaffPerm('manageTournaments'))
        && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && (isSuperAdmin() || incoming().tournamentId == existing().tournamentId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(playerId)
        && (isSuperAdmin() || (hasStaffPerm('managePlayers') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /players_private/{playerId} {
      allow get: if isValidId(playerId) && hasStaffPerm('managePlayers') && canAccessTournament(existing().tournamentId);
      allow list: if isBootstrappedSuperAdmin() || hasStaffPerm('managePlayers');
      allow create: if isValidId(playerId) && isValidPlayerPrivate(incoming(), playerId)
        && hasStaffPerm('managePlayers') && hasStaffPerm('canCreate')
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/players_public/$(playerId));
      allow update: if isValidId(playerId) && isValidPlayerPrivate(incoming(), playerId)
        && hasStaffPerm('managePlayers') && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && incoming().playerId == existing().playerId
        && (isSuperAdmin() || incoming().tournamentId == existing().tournamentId);
      allow delete: if isValidId(playerId)
        && (isSuperAdmin() || (hasStaffPerm('managePlayers') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /registrations/{registrationId} {
      allow get: if isValidId(registrationId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(registrationId) && isValidRegistration(incoming(), registrationId)
        && (hasStaffPerm('manageDraws') || hasStaffPerm('manageTournaments'))
        && hasStaffPerm('canCreate')
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/divisions/$(incoming().divisionId));
      allow update: if isValidId(registrationId) && isValidRegistration(incoming(), registrationId)
        && hasStaffPerm('manageDraws') && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().divisionId == existing().divisionId
        && incoming().registeredAt == existing().registeredAt;
      allow delete: if isValidId(registrationId)
        && (isSuperAdmin() || (hasStaffPerm('manageDraws') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /groups/{groupId} {
      allow get: if isValidId(groupId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(groupId) && isValidGroup(incoming(), groupId)
        && (hasStaffPerm('manageDraws') || hasStaffPerm('manageTournaments'))
        && (hasStaffPerm('canCreate') || hasStaffPerm('canEdit'))
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/divisions/$(incoming().divisionId));
      allow update: if isValidId(groupId) && isValidGroup(incoming(), groupId)
        && (hasStaffPerm('manageDraws') || hasStaffPerm('manageScoring'))
        && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().divisionId == existing().divisionId;
      allow delete: if isValidId(groupId)
        && (isSuperAdmin() || (hasStaffPerm('manageDraws') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /matchdays/{matchdayId} {
      allow get: if isValidId(matchdayId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(matchdayId) && isValidMatchday(incoming(), matchdayId)
        && (hasStaffPerm('manageScheduleAndMedia') || hasStaffPerm('manageTournaments'))
        && hasStaffPerm('canCreate')
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/divisions/$(incoming().divisionId));
      allow update: if isValidId(matchdayId) && isValidMatchday(incoming(), matchdayId)
        && hasStaffPerm('manageScheduleAndMedia') && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().divisionId == existing().divisionId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(matchdayId)
        && (isSuperAdmin() || (hasStaffPerm('manageScheduleAndMedia') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /matches/{matchId} {
      allow get: if isValidId(matchId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(matchId) && isValidMatch(incoming(), matchId)
        && (hasStaffPerm('manageDraws') || hasStaffPerm('manageTournaments') || (hasStaffPerm('manageScoring') && incoming().phase in ['eliminacion', 'clasificatoria']))
        && (hasStaffPerm('canCreate') || hasStaffPerm('canEdit'))
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/divisions/$(incoming().divisionId));
      allow update: if isValidId(matchId) && isValidMatch(incoming(), matchId)
        && (hasStaffPerm('manageDraws') || hasStaffPerm('manageScheduleAndMedia') || hasStaffPerm('manageScoring'))
        && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().divisionId == existing().divisionId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(matchId)
        && (isSuperAdmin() || ((hasStaffPerm('manageDraws') || hasStaffPerm('manageScoring')) && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /photos/{photoId} {
      allow get: if isValidId(photoId) && (existing().published == true || isActiveStaff());
      allow list: if isActiveStaff() || (resource.data.published == true && request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(photoId) && isValidPhoto(incoming(), photoId)
        && hasStaffPerm('manageScheduleAndMedia') && (hasStaffPerm('canCreate') || hasStaffPerm('canEdit'))
        && canAccessTournament(incoming().tournamentId)
        && incoming().published == true
        && exists(/databases/$(database)/documents/matchdays/$(incoming().matchdayId));
      allow update: if isValidId(photoId) && isValidPhoto(incoming(), photoId)
        && hasStaffPerm('manageScheduleAndMedia') && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().published == true
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().divisionId == existing().divisionId
        && incoming().matchdayId == existing().matchdayId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(photoId)
        && (isSuperAdmin() || (hasStaffPerm('manageScheduleAndMedia') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /photos_drafts/{photoId} {
      allow get: if isValidId(photoId) && isActiveStaff();
      allow list: if isActiveStaff() && resource.data.published == false;
      allow create: if isValidId(photoId) && isValidPhoto(incoming(), photoId)
        && hasStaffPerm('manageScheduleAndMedia') && (hasStaffPerm('canCreate') || hasStaffPerm('canEdit'))
        && canAccessTournament(incoming().tournamentId)
        && incoming().published == false
        && exists(/databases/$(database)/documents/matchdays/$(incoming().matchdayId));
      allow update: if isValidId(photoId) && isValidPhoto(incoming(), photoId)
        && hasStaffPerm('manageScheduleAndMedia') && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().published == false
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().divisionId == existing().divisionId
        && incoming().matchdayId == existing().matchdayId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(photoId)
        && hasStaffPerm('manageScheduleAndMedia')
        && (hasStaffPerm('canEdit') || hasStaffPerm('canDelete'))
        && canAccessTournament(existing().tournamentId);
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(notificationId) && isValidNotification(incoming(), notificationId)
        && isActiveStaff() && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/tournaments/$(incoming().tournamentId));
      allow update: if isValidId(notificationId) && isValidNotification(incoming(), notificationId)
        && isActiveStaff() && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && incoming().tournamentId == existing().tournamentId
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(notificationId) && isSuperAdmin();
    }

    match /tournament_ads/{adId} {
      allow get: if isValidId(adId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(adId) && isValidTournamentAd(incoming(), adId)
        && hasStaffPerm('manageTournaments') && hasStaffPerm('canCreate')
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/tournaments/$(incoming().tournamentId));
      allow update: if isValidId(adId) && isValidTournamentAd(incoming(), adId)
        && hasStaffPerm('manageTournaments') && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && (isSuperAdmin() || incoming().tournamentId == existing().tournamentId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(adId)
        && (isSuperAdmin() || (hasStaffPerm('manageTournaments') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /tournament_trophies/{trophyId} {
      allow get: if isValidId(trophyId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(trophyId) && isValidTournamentTrophy(incoming(), trophyId)
        && hasStaffPerm('manageTournaments') && hasStaffPerm('canCreate')
        && canAccessTournament(incoming().tournamentId)
        && exists(/databases/$(database)/documents/tournaments/$(incoming().tournamentId));
      allow update: if isValidId(trophyId) && isValidTournamentTrophy(incoming(), trophyId)
        && hasStaffPerm('manageTournaments') && hasStaffPerm('canEdit')
        && canAccessTournament(incoming().tournamentId)
        && incoming().id == existing().id
        && (isSuperAdmin() || incoming().tournamentId == existing().tournamentId)
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(trophyId)
        && (isSuperAdmin() || (hasStaffPerm('manageTournaments') && hasStaffPerm('canDelete')))
        && canAccessTournament(existing().tournamentId);
    }

    match /site_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isActiveStaff() || (request.query.limit != null && request.query.limit <= 500);
      allow create: if isValidId(settingId) && isValidSiteLandingConfig(incoming(), settingId)
        && (isSuperAdmin() || (hasStaffPerm('manageLandingPage') && (hasStaffPerm('canCreate') || hasStaffPerm('canEdit'))));
      allow update: if isValidId(settingId) && isValidSiteLandingConfig(incoming(), settingId)
        && (isSuperAdmin() || (hasStaffPerm('manageLandingPage') && hasStaffPerm('canEdit')))
        && (!('id' in existing()) || incoming().id == existing().id);
      allow delete: if isValidId(settingId) && isSuperAdmin();
    }
  }
}
